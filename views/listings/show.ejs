<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <h3 class="offset-4 mb-3">
            <%= listing.title %>
        </h3>
        <div class="col-4 offset-4">
            <div class="card" style="border:none">
                <img src="<%= listing.image.url %>" class="card-img-top" style="height: 25rem;" alt="...">
                <div class="card-body d-flex">
                    <div class="card-text show-card-text mb-2">
                        <div class="show-listing-location">
                            <%= listing.location %>,<%= listing.country %>
                        </div>
                        <div class="show-listing-price">
                            <small>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
                            </small>
                        </div>
                    </div>
                    <p class="card-text show-listing-desc">
                        <%= listing.description %>
                    </p>
                </div>
            </div>
        </div>
        <div class="buttons offset-4 mt-3 d-flex mb-3">
            <div>
                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                    <button class="show-del-btn">Delete</button>
                </form>
            </div>
            <div class="edit-btn offset-3">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark show-edit-btn">
                    Edit
                </a>
            </div>
        </div>
        <hr />
        <div class="col-4 offset-4 mb-3">
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

                <div class="star-rating">
                    <input type="radio" id="star5" name="review[rating]" value="5" required />
                    <label for="star5">★</label>

                    <input type="radio" id="star4" name="review[rating]" value="4" />
                    <label for="star4">★</label>

                    <input type="radio" id="star3" name="review[rating]" value="3" />
                    <label for="star3">★</label>

                    <input type="radio" id="star2" name="review[rating]" value="2" />
                    <label for="star2">★</label>

                    <input type="radio" id="star1" name="review[rating]" value="1" />
                    <label for="star1">★</label>
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" class="form-control" rows="3" required></textarea>
                    <div class="invalid-feedback">Enter a comment</div>
                </div>

                <button type="submit" class="btn btn-outline-dark"
                    style="background-color: rgba(255, 0, 140, 0.703);border: none;color: white;">
                    Submit
                </button>
            </form>
        </div>
        <hr />
        <h4 class="offset-4">All Reviews</h4>
        <div class="offset-4 col-4 row gap-3 mb-3">
            <% for (review of listing.reviews) { %>
                <div class="review-card col-2">
                    <p class="review-username">Username</p>
                    <p class="review-rating">
                        <% for (let i=1; i <=5; i++) { %>
                            <span class="<%= i <= review.rating ? 'star-filled' : 'star-empty' %>">★</span>
                            <% } %>
                    </p>
                    <p class="review-comment">
                        <%= review.comment %>
                    </p>
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                        <button type="submit" class="btn btn-sm ">
                            <i class="bi bi-trash3-fill" style="font-size: 1rem;"></i>
                        </button>
                    </form>
                </div>
                <% } %>
        </div>
    </div>