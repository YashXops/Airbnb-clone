<% layout("/layouts/boilerplate") %>


    <div class="container-fluid">
        <div class=" row row-cols-lg-4 row-cols-md-3 row-cols-sm-1 g-3">
            <% for (const list of allListings) { %>
                <div class="col">
                    <a href="/listings/<%= list._id %>" class="listing-link mb-3">
                        <div class="card my-2 d-flex">
                            <img src="<%= list.image.url %>" class="card-img-top" style="height: 25rem;" alt="">
                            <div class="card-body d-flex">
                                <h5 class="card-title">
                                    <%= list.title %>
                                </h5>
                                <div class="listing-desc-wrapper mb-1">
                                    <p class="card-text listing-desc">
                                        <%= list.description %>
                                    </p>
                                </div>
                                <p class="card-text listing-price"><small>
                                        &#8377;<%= list.price.toLocaleString("en-IN") %> / night
                                    </small></p>
                            </div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    </div>